# ── Virtual Environments ──────────────────────────────────────────────────────
venv_stable/
venv/
.venv/

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
*.env
backend/.env

# ── Python Artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── AI Model Weights (GitHub 100MB limit) ─────────────────────────────────────
*.pt
*.pth
*.onnx
*.bin
models/*
!models/.gitkeep
TrackNetV3/ckpts/

# ── Large Media & Assets ──────────────────────────────────────────────────────
assets/*
!assets/.gitkeep

# ── TrackNetV3 (third-party repo outputs) ─────────────────────────────────────
TrackNetV3/output/*
!TrackNetV3/output/.gitkeep

# ── Pipeline Outputs (generated, not source) ──────────────────────────────────
data/output/*
data/input/*
data/temp/*
data/sessions/*
!data/output/.gitkeep
!data/input/.gitkeep
!data/temp/.gitkeep
!data/sessions/.gitkeep

# ── Java / Maven ──────────────────────────────────────────────────────────────
backend/target/
analyzer/target/
*.class
*.jar

# ── IDE & OS Files ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db